# Neon Postgres connection string — get it from https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require

# Key used to log into /admin (change this)
Seeded account: admin@saqib.dev / admin1234

ADMIN_KEY=change-me

# Neon Object Storage (S3-compatible). Without these, uploads fall back to
# public/uploads on local disk. Get them via:
#   neon credentials create --scope storage:read --scope storage:write
# or in the Console → Object storage tab. Bucket should have public_read access.
NEON_BUCKET=my-bucket
AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-2.us-east-1.aws.neon.tech
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=nak_live_...
AWS_SECRET_ACCESS_KEY=nsk_live_...
